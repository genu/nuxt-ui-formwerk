{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommitTypeAll(chore)",
    ":label(dependencies)",
    ":disablePeerDependencies"
  ],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "description": "Hold TypeScript at v6. TypeScript 7 breaks @nuxt/module-builder, which does `import { convertCompilerOptionsFromJson } from \"typescript\"` — TS7 no longer exposes that as a Node-detectable CJS named export, so `pnpm dev:prepare` fails. Remove this once module-builder ships an ESM-safe import.",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    },
    {
      "description": "Group Nuxt ecosystem packages",
      "groupName": "nuxt",
      "matchPackageNames": ["/^@nuxt//", "/^nuxt$/", "/^nuxi$/"],
      "excludePackageNames": ["@nuxt/ui"]
    },
    {
      "description": "Group Vitest packages",
      "groupName": "vitest",
      "matchPackageNames": ["/^vitest$/", "/^@vitest//"]
    },
    {
      "description": "Group linting tools",
      "groupName": "linting",
      "matchPackageNames": ["/^eslint/", "/^prettier/"]
    },
    {
      "description": "Group Formwerk packages",
      "groupName": "formwerk",
      "matchPackageNames": ["/^@formwerk//"]
    },
    {
      "description": "Group VueUse packages",
      "groupName": "vueuse",
      "matchPackageNames": ["/^@vueuse//"]
    },
    {
      "description": "Automerge minor/patch devDependencies",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    }
  ]
}
