{
  "name": "nuxt-ui-formwerk",
  "version": "0.1.23",
  "description": "A collection of beautiful, animated UI components for Nuxt applications",
  "license": "MIT",
  "repository": "https://github.com/genu/nuxt-ui-formwerk.git",
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "scripts": {
    "prepack": "nuxt-module-build build",
    "verify:dist": "vue-tsc --noEmit -p test/consumer/tsconfig.json",
    "dev": "pnpm dev:prepare && nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare",
    "dev:prepare:playground": "pnpm dev:prepare && nuxi prepare playground",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && vue-tsc --noEmit -p test/types/tsconfig.json",
    "test:types:playground": "vue-tsc --noEmit -p playground/tsconfig.json",
    "test:types:all": "pnpm test:types && pnpm test:types:playground"
  },
  "dependencies": {
    "@nuxt/kit": "4.5.1",
    "@vueuse/core": "14.4.0"
  },
  "devDependencies": {
    "@nuxt/devtools": "3.4.1",
    "@nuxt/eslint-config": "1.16.0",
    "@nuxt/module-builder": "1.0.3",
    "@nuxt/schema": "4.5.1",
    "@nuxt/test-utils": "4.1.0",
    "@types/culori": "4.0.1",
    "@types/node": "latest",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "nuxt": "4.5.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.9",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@formwerk/core": "^0.14.4",
    "@nuxt/ui": "^4.0.0",
    "@internationalized/date": "^3.10.0"
  }
}
